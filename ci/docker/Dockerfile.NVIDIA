FROM nvcr.io/nvidia/pytorch:26.09-py3

RUN apt-get update && apt-get install -y \
  g++ \
  git \
  curl \
  python3-venv \
  zstd \
  strace \
  gdb \
  python3-dbg \
  linux-tools-common linux-tools-generic \
  libboost-fiber-dev libtbb-dev autoconf cmake \
  rclone \
  && rm -rf /var/lib/apt/lists/*

# current set of nnue-pytorch dependencies, some already in the image
RUN pip install --no-cache-dir psutil asciimatics GPUtil "python-chess==0.31.4" matplotlib tensorboard numba "numpy<2.0" requests tyro schedulefree torchmetrics>=1.8.2 scipy pybind11

# NGC 26.09 does not include CuPy. Install the CUDA 13 wheel so nnue-pytorch
# uses its custom CUDA kernels instead of the PyTorch fallback.
RUN python -m pip install --no-cache-dir cupy-cuda13x==13.6.0 \
    && python -c "import cupy"

# for optimization
RUN pip install --no-cache-dir  nevergrad

# firecrest-executor will allow for remote execution
RUN pip install --no-cache-dir "firecrest-executor>=0.3.1"

# enabler for hf downloads
RUN pip install huggingface_hub zstandard hf_xet

# allow for matetrack functionality
RUN pip install --no-cache-dir chess tqdm

# for cdbdirect
RUN pip install pybind11
ENV CFLAGS="-fPIC"
ENV CXXFLAGS="-fPIC"
ENV EXTRA_CFLAGS="-fPIC"
ENV EXTRA_CXXFLAGS="-fPIC"
ENV TERARKDBROOT=/workspace/terarkdb/
ENV CHESSDB_PATH=/workspace/cdb/chess-20251115/data

ARG NUM_PROCS

RUN cd /workspace/ &&  git clone https://github.com/noobpwnftw/terarkdb.git && cd terarkdb && ./build.sh -j $NUM_PROCS

RUN cd /workspace/ &&  git clone https://github.com/vondele/cdbdirect.git && cd cdbdirect && \
  make -j $NUM_PROCS TERARKDBROOT=$TERARKDBROOT CHESSDB_PATH=$CHESSDB_PATH && \
  pip install --no-build-isolation .

# the nettest sources are not baked into the image: CI jobs get them from the
# git checkout mounted at $CI_PROJECT_DIR (via PYTHONPATH), and for local
# execution the repo is mounted into the container (see README.md)

# note that the CI picks a different workdir (mounted by default in the workspace)
WORKDIR /workspace/
